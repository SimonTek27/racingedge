+impl Runtime {
+    pub fn render(&mut self, out: &mut [f32]) {
+        let t0 = std::time::Instant::now();
+        self.sync_event_spatial_gains();
+        self.snapshots.apply(&mut self.mixer);
+        let ch = self.channels as usize;
+        if ch == 0 || out.len() % ch != 0 {
+            out.fill(0.0);
+            return;
+        }
+        let frames = out.len() / ch;
